# Copy to .env at the repo root. Both processes read it:
#   - the LangGraph server, via `"env": "../.env"` in backend/langgraph.json
#   - the Next frontend, which Next loads automatically from the repo root only
#     if you run it from there; the setup in README §5 symlinks it instead.

# --- Required -------------------------------------------------------------

# Every graph in backend/src/agents runs on OpenAI. Also used by the voice
# route's transcription service (Whisper).
OPENAI_API_KEY=sk-...

# --- Optional -------------------------------------------------------------

# Where the LangGraph server is listening. The Next runtime route passes this
# to `new LangGraphAgent({ deploymentUrl })`.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# Only needed when pointing LangGraphAgent at a LangSmith/LangGraph Platform
# deployment instead of a local `langgraphjs dev` server.
# LANGSMITH_API_KEY=

# Override the model every graph uses. Defaults to gpt-4o-mini, which is what
# the doc snippets use.
# OPENAI_MODEL=gpt-4o-mini

# The A2UI dynamic-schema route only. It has to read a large JSON-Schema
# catalog out of context and emit a conforming component tree, which
# gpt-4o-mini does not do reliably. Defaults to gpt-4o, the model the doc's
# own A2UI example uses.
# OPENAI_A2UI_MODEL=gpt-4o

# The Reasoning routes need a model that emits reasoning tokens; the docs name
# o1, o3 and o4-mini.
# OPENAI_REASONING_MODEL=o4-mini

# Reasoning *summaries* — the visible trace those routes render — require a
# verified OpenAI organization. Unverified orgs get a hard 400. Set this to
# `off` to keep reasoning on but drop the summary: the routes then answer
# normally, just without a reasoning card.
#   auto (default) | concise | detailed | off
# OPENAI_REASONING_SUMMARY=auto

# Set to `off` to disable the CopilotKit inspector overlay everywhere.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off
